{
  "name": "rack-and-recall",
  "productName": "Rack & Recall",
  "version": "1.5.0",
  "description": "NWL2023 word study with an FSRS cardbox",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never",
    "android:add": "cap add android",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rackrecall.app",
    "productName": "Rack & Recall",
    "copyright": "Personal use",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "web/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Rack-and-Recall-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Rack and Recall",
      "artifactName": "Rack-and-Recall-Setup-${version}.exe",
      "uninstallDisplayName": "Rack and Recall"
    },
    "executableName": "RackAndRecall"
  }
}
